{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ViewDefinition Depot R4 HDS projection contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractFormatVersion", "resource", "table", "fhirVersion", "hdsVersion", "deployment", "provenance", "projection"],
  "properties": {
    "contractFormatVersion": {"const": "1"},
    "resource": {"$ref": "#/$defs/typeName"},
    "table": {"$ref": "#/$defs/typeName"},
    "fhirVersion": {"const": "4.0.1"},
    "hdsVersion": {"const": "1.4.0"},
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaSha256", "schemaStringSha256", "fields"],
      "properties": {
        "schemaSha256": {"$ref": "#/$defs/sha256"},
        "schemaStringSha256": {"$ref": "#/$defs/sha256"},
        "fields": {
          "type": "array", "minItems": 1,
          "items": {
            "description": "Ordered field: name, nullable, logical primitive or content-addressed types.json key.",
            "type": "array", "minItems": 3, "maxItems": 3,
            "prefixItems": [
              {"$ref": "#/$defs/nonempty"},
              {"type": "boolean"},
              {"type": "string", "pattern": "^(string|int32|bool|date32\\[day\\]|timestamp\\[us, tz=UTC\\]|decimal128\\([0-9]+, [0-9]+\\)|@[0-9a-f]{64})(?![\\s\\S])"}
            ]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "creationLogPath", "creationLogSha256", "sourceArtifactSha256", "fhirStructureDefinition"],
      "properties": {
        "release": {"$ref": "#/$defs/nonempty"},
        "creationLogPath": {"$ref": "#/$defs/nonempty"},
        "creationLogSha256": {"$ref": "#/$defs/sha256"},
        "sourceArtifactSha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "fhirStructureDefinition": {
          "type": "object", "additionalProperties": false, "required": ["canonical", "packagePath", "sha256"],
          "properties": {
            "canonical": {"$ref": "#/$defs/nonempty"},
            "packagePath": {"$ref": "#/$defs/nonempty"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view", "columns", "targetMappings"],
      "properties": {
        "view": {"type": "string", "pattern": "^views/r4/fabric-silver-hds/[A-Z][A-Za-z0-9]*\\.json(?![\\s\\S])"},
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path", "type", "fhirElement", "fhirType", "min", "max", "mappingKind", "evidence", "targetFields"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(?![\\s\\S])"},
              "path": {"$ref": "#/$defs/nonempty"},
              "type": {"enum": ["string", "integer", "boolean", "decimal"]},
              "collection": {"type": "boolean"},
              "fhirElement": {"$ref": "#/$defs/nonempty"},
              "fhirType": {"$ref": "#/$defs/nonempty"},
              "min": {"type": "integer", "minimum": 0},
              "max": {"type": "string", "pattern": "^(\\*|[1-9][0-9]*)(?![\\s\\S])"},
              "targetFields": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
              "mappingKind": {"$ref": "#/$defs/mappingKind"},
              "evidence": {"$ref": "#/$defs/evidence"}
            }
          }
        },
        "targetMappings": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["field", "reason", "mappingKind", "evidence"],
            "properties": {
              "field": {"$ref": "#/$defs/nonempty"},
              "reason": {"$ref": "#/$defs/nonempty"},
              "sourceColumn": {"$ref": "#/$defs/nonempty"},
              "mappingKind": {"$ref": "#/$defs/mappingKind"},
              "evidence": {"$ref": "#/$defs/evidence"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "mappingKind": {"enum": ["direct", "serialized", "derived", "unsupported"]},
    "evidence": {"enum": ["contract-sourced", "source-derived", "runtime-observed"]},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])", "maxLength": 64},
    "typeName": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*(?![\\s\\S])"}
  }
}
